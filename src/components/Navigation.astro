---
const links = [
  { href: '/', label: 'Home' },
  { href: '/archives', label: 'Archive' },
  { href: '/tags', label: 'Tags' },
  { href: '/resume', label: 'Resume' },
];
const pathname = Astro.url.pathname;
function isActiveHref(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
}
function linkClass(href: string) {
  const active = isActiveHref(href);
  return `text-sm transition-colors ${active ? 'text-foreground font-medium' : 'text-muted-foreground hover:text-foreground'}`;
}
---
<nav class="sticky top-0 z-50" transition:persist="main-nav">
  <div class="container mx-auto px-6">
    <div class="flex h-16 items-center justify-center">
      <div class="flex items-center gap-6">
        {links.map((l) => (
          <a
            href={l.href}
            data-nav-href={l.href}
            class={linkClass(l.href)}
            aria-current={isActiveHref(l.href) ? 'page' : undefined}
          >{l.label}</a>
        ))}
      </div>
    </div>
  </div>
</nav>

<script>
  function updateNav() {
    const pathname = window.location.pathname;
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('nav a[data-nav-href]');
    navLinks.forEach((link) => {
      const href = link.getAttribute('data-nav-href');
      if (!href) return;
      const isActive = href === '/'
        ? pathname === '/'
        : pathname === href || pathname.startsWith(href + '/');
      if (isActive) {
        link.classList.remove('text-muted-foreground');
        link.classList.add('text-foreground', 'font-medium');
        link.setAttribute('aria-current', 'page');
      } else {
        link.classList.remove('text-foreground', 'font-medium');
        link.classList.add('text-muted-foreground');
        link.removeAttribute('aria-current');
      }
    });
  }

  document.addEventListener('astro:page-load', updateNav);
</script>