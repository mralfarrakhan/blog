---
export interface SpecLink {
  text: string;
  href: string;
  target?: string;
  rel?: string;
}

export interface SpecItem {
  label: string;
  value?: string;
  links?: SpecLink[];
  fullWidth?: boolean;
}

interface Props {
  items: SpecItem[];
  columns?: 1 | 2;
  class?: string;
}

const { items = [], columns = 2, class: className = '' } = Astro.props;

const gridCols = columns === 1 ? 'grid-cols-1' : 'grid-cols-1 sm:grid-cols-2';
---

<div class={`grid ${gridCols} gap-2.5 my-6 ${className}`}>
  {items.map((item) => (
    <div
      class={`flex flex-col sm:flex-row sm:items-center justify-between gap-1 px-3.5 py-2.5 rounded-lg border border-border/60 bg-card/30 ${
        item.fullWidth ? 'sm:col-span-2' : ''
      }`}
    >
      <span class="text-xs font-mono text-muted-foreground">{item.label}</span>
      <span class="text-xs font-mono text-foreground font-medium">
        {item.links && item.links.length > 0
          ? item.links.map((link, idx) => (
              <>
                {idx > 0 && <span class="text-muted-foreground mx-1">+</span>}
                <a
                  href={link.href}
                  target={
                    link.target ??
                    (link.href.startsWith('http') ? '_blank' : undefined)
                  }
                  rel={
                    link.rel ??
                    (link.href.startsWith('http')
                      ? 'noopener noreferrer'
                      : undefined)
                  }
                  class="!no-underline hover:text-accent transition-colors"
                >
                  {link.text}
                </a>
              </>
            ))
          : item.value}
      </span>
    </div>
  ))}
</div>
