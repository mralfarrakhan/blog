---
import Base from './Base.astro';
import { ChevronRight } from '@lucide/astro';
import '../styles/archives.css';

interface Props {
  content?: {
    title?: string;
    description?: string;
  };
  frontmatter?: {
    title?: string;
    description?: string;
  };
  title?: string;
  description?: string;
}

const {
  frontmatter,
  content,
  title: propTitle,
  description: propDescription,
} = Astro.props;
const title = frontmatter?.title ?? content?.title ?? propTitle ?? 'About';
const description =
  frontmatter?.description ?? content?.description ?? propDescription;
---

<Base title={title} description={description}>
  <section class="container mx-auto px-6 pt-16 pb-20 flex-grow">
    <div class="max-w-3xl mx-auto">
      <nav class="mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-muted-foreground">
          <li>
            <a href="/" class="hover:text-foreground transition-colors">
              Home
            </a>
          </li>
          <li class="flex items-center gap-2">
            <ChevronRight size={14} aria-hidden="true" />
            <span class="text-foreground font-medium">{title}</span>
          </li>
        </ol>
      </nav>

      <header class="mb-8 border-b border-border/40 pb-6">
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-balance text-foreground">
          {title}
        </h1>
        {description && (
          <p class="mt-3 text-base text-muted-foreground leading-relaxed">
            {description}
          </p>
        )}
      </header>

      <article class="prose max-w-none">
        <slot />
      </article>
    </div>
  </section>
</Base>
