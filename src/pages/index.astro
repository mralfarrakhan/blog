---
import Base from '../layouts/Base.astro';
import siteInfo from '../../public/0user.json';
import { BadgeGroup } from '$components/ui';
import { info } from '$lib/info';
---

<Base title={siteInfo.site.title} description={siteInfo.site.description}>
  <section class="container mx-auto px-6 py-16 grow flex flex-col justify-center">
    <div class="max-w-3xl mx-auto w-full">
      <h1 class="mb-2 text-4xl md:text-5xl font-bold tracking-tight text-balance">
        {siteInfo.name}
      </h1>
      <p class="mb-4 text-lg md:text-xl text-muted-foreground">
        {siteInfo.role}
      </p>

      <p class="mb-4 text-base md:text-lg text-foreground/85 leading-relaxed text-pretty">
        {siteInfo.home.bio}
      </p>
      <p class="mb-10 text-base md:text-lg text-foreground/85 leading-relaxed text-pretty">
        {siteInfo.home.note}
      </p>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        <BadgeGroup
          items={[
            ...info.contacts,
            { label: 'rss', text: '/rss.xml', href: '/rss.xml' },
          ]}
        />
      </div>
    </div>
  </section>
</Base>
